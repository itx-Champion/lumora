# Copy this file to .env.local and fill in what you need. Never commit .env.local.
# Every key is optional except AUTH_SECRET: without AI keys the app runs in
# demo mode (extractive answers from your documents, rule-based agent actions).

# Required. Generate with: npx auth secret
AUTH_SECRET=

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# Groq (free tier), used automatically if Gemini fails: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional GitHub login: https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional Upstash Redis (free) for rate limiting across serverless instances
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
